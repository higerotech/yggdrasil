# Copiar a .env, chmod 600 y rellenar. NUNCA commitear .env: este repositorio es público.
# Los valores de ejemplo están en 192.0.2.0/24, el rango que RFC 5737 reserva para
# documentación, para que se vea a simple vista que son marcadores y no un despliegue real.

# IP LAN del appliance: bind del único puerto publicado (Grafana :3000) y root_url.
HOST_LAN_IP=192.0.2.10

# IP de docker0 en el host. Las sondas en host-mode escuchan aquí (9115 y 9469) para que
# Mimir las alcance vía host.docker.internal sin exponerlas a la LAN ni a las WAN.
# Cambiar solo si el daemon usa otro "bip" (docker network inspect bridge).
DOCKER_HOST_GW=172.17.0.1

# Interfaces WAN (nombres que fija el proyecto de routing). render.sh resuelve sus IPv4
# actuales y las escribe en blackbox.yml; re-ejecutar render.sh si el ISP cambia la IP.
WAN1_IF=wan1
WAN2_IF=wan2
# Para forzar las IPs a mano, descomentar (si están vacías se toman de las interfaces):
# WAN1_IP=192.0.2.101
# WAN2_IP=192.0.2.102

# Sleipnir (throughput). Ciclo cada 3 h alternando WAN: cada WAN se mide cada 6 h (RF02, T5).
# Modo: speedtest (sin servidor propio) o iperf3 (requiere IPERF3_SERVER).
SLEIPNIR_MODO=speedtest
SLEIPNIR_INTERVALO=10800
IPERF3_SERVER=

# Odín (Grafana): cuenta administradora; sin acceso anónimo (RS01).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR

# Ratatosk (Mosquitto, servicio de plataforma, ADR-0006): un usuario por cliente, con ACL.
# El archivo passwd se genera al arrancar el contenedor a partir de estas variables.
MQTT_NORNAS_PASSWORD=CAMBIAR
MQTT_FRIGATE_PASSWORD=CAMBIAR
MQTT_IOT_PASSWORD=CAMBIAR

# Nornas (Node-RED, servicio de plataforma): editor con login obligatorio en la IP LAN (1880);
# secreto estable para cifrar las credenciales de los flujos. El webhook de Alertmanager llega
# por la red interna de Compose con token Bearer en la cabecera (T4).
NORNAS_ADMIN_USER=admin
NORNAS_ADMIN_PASSWORD=CAMBIAR
NORNAS_CREDENTIAL_SECRET=CAMBIAR
NORNAS_URL=http://nornas:1880/heimdall/alertas
NORNAS_WEBHOOK_TOKEN=CAMBIAR

# Receptor de la alerta WanThroughputBajo: "nulo" hasta calibrar el techo de medición
# (Gate 3); después "nornas".
THROUGHPUT_RECEIVER=nulo

TZ=America/Caracas
