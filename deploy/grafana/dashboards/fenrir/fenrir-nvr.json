{
  "annotations": {
    "list": [
      {
        "name": "Alertas de Fenrir",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", servicio=\"fenrir\"}",
        "titleFormat": "{{alertname}} {{camera_name}}"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Alertas de Fenrir activas",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "count(ALERTS{servicio=\"fenrir\", alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Alertas del grupo `fenrir` en firing. El detalle esta en la tabla del final, que incluye tambien las pendientes."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CPU del appliance",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "frigate_cpu_usage_percent{pid=\"frigate.full_system\"}",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 70
              }
            ]
          },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "description": "Sistema entero, escala 0-100. Amarillo en 50 (presupuesto RNF01 del NVR) y rojo en 70 (umbral de CpuNvrAlta). La media medida es ~56 %, asi que estar en amarillo es lo normal hoy, no una novedad."
    },
