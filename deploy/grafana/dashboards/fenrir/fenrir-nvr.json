            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "La serie `frigate.full_system` es la unica de esta metrica en escala 0-100."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU de Frigate por papel (% de UN nucleo · pasa de 100)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (type) (frigate_cpu_usage_percent{type!=\"\", type!=\"Other\"})",
          "legendFormat": "{{type}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "detectors"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Camera"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Relativas a UN nucleo, asi que superan el 100 % (`detectors` ronda 192 en 4 hilos). Va en panel aparte por eso: mezclarla con la del sistema exigiria dos ejes. Sirve para ATRIBUIR: si la CPU del appliance sube y `detectors` no, el NVR es la victima y no la causa. Se agrupa por `type` y no por `process` porque esa etiqueta tiene 55 valores (para `type=\"Other\"` lleva la linea de comandos entera), y se excluye `Other` porque NO es trabajo extra: es cada proceso contado una segunda vez, y sumarlo duplicaba el total (406 % frente a los 248 % reales del appliance)."
    },
